<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cosmetic INCI Analyzer & Database</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        luxury: {
                            dark: '#1C1C1A',
                            muted: '#2C2C2A',
                            gold: '#C5A059',
                            goldLight: '#E6D5B8',
                            bg: '#F9F8F6',
                            card: '#FFFFFF',
                            border: '#E8E5DF'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-luxury-bg text-luxury-dark min-h-screen flex flex-col font-sans selection:bg-luxury-gold selection:text-white">

    <!-- Header -->
    <header class="bg-luxury-dark text-white py-8 px-4 border-b border-luxury-muted">
        <div class="max-w-4xl mx-auto text-center">
            <span class="text-luxury-gold text-xs uppercase tracking-[0.3em] font-medium">Professional Skincare</span>
            <h1 class="text-2xl sm:text-3xl font-light tracking-wide mt-2">INCI Analyzer</h1>
            <p class="text-stone-400 text-xs tracking-wider mt-1 uppercase">Эстетика и корнеотерапевтическая безопасность</p>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-4xl w-full mx-auto p-4 sm:p-8 space-y-6">

        <!-- Input Box -->
        <div class="bg-luxury-card rounded-xl shadow-sm border border-luxury-border p-6 sm:p-8 transition-all">
            <label for="inciInput" class="block text-xs uppercase tracking-wider font-semibold text-stone-500 mb-3">Введите или вставьте состав (INCI):</label>
            <textarea id="inciInput" rows="4" class="w-full p-4 bg-luxury-bg border border-luxury-border rounded-lg focus:ring-1 focus:ring-luxury-gold focus:border-luxury-gold text-sm outline-none transition text-luxury-dark placeholder-stone-400" placeholder="Например: Aqua, Niacinamide, Squalane, Bis-Ethylhexyloxyphenol Methoxyphenyl Triazine..."></textarea>
            
            <!-- Кнопки пресетов без картинок -->
            <div class="flex flex-wrap gap-2.5 mt-5 items-center">
                <button onclick="loadPreset('foam')" class="bg-luxury-bg hover:bg-stone-200 text-luxury-dark border border-luxury-border px-4 py-2.5 rounded-lg text-xs uppercase tracking-wider transition font-medium">Пенка</button>
                <button onclick="loadPreset('toner')" class="bg-luxury-bg hover:bg-stone-200 text-luxury-dark border border-luxury-border px-4 py-2.5 rounded-lg text-xs uppercase tracking-wider transition font-medium">Тонер</button>
                <button onclick="loadPreset('cream')" class="bg-luxury-bg hover:bg-stone-200 text-luxury-dark border border-luxury-border px-4 py-2.5 rounded-lg text-xs uppercase tracking-wider transition font-medium">Крем</button>
                <button onclick="loadPreset('spf')" class="bg-luxury-bg hover:bg-stone-200 text-luxury-dark border border-luxury-border px-4 py-2.5 rounded-lg text-xs uppercase tracking-wider transition font-medium">СПФ</button>
                <button onclick="analyzeINCI()" class="bg-luxury-dark hover:bg-luxury-muted text-white font-medium px-6 py-2.5 rounded-lg shadow-sm transition text-xs uppercase tracking-wider">Анализировать</button>
                <button onclick="clearAll()" class="text-stone-400 hover:text-stone-700 px-3 py-2 text-xs uppercase tracking-wider transition ml-auto">Очистить</button>
            </div>
        </div>

        <!-- Results Section -->
        <div id="resultsContainer" class="hidden space-y-4">
            <div class="bg-luxury-card rounded-xl shadow-sm border border-luxury-border p-6 sm:p-8">
                <h2 class="text-xs uppercase tracking-[0.2em] font-semibold text-stone-400 mb-6 pb-3 border-b border-luxury-border">Результаты разбора</h2>
                <div id="ingredientsList" class="space-y-3">
                    <!-- Dynamic Items -->
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-luxury-dark border-t border-luxury-muted py-6 text-center text-xs tracking-widest text-stone-400 mt-auto uppercase">
        Quiet Luxury Skincare &bull; Database & Analysis
    </footer>

    <!-- Script Logic -->
    <script>
        const ingredientDatabase = {
            "aqua": { name: "Aqua / Water (Вода)", type: "Растворитель", desc: "Основа косметического средства." },
            "glycerin": { name: "Glycerin (Глицерин)", type: "Увлажнитель", desc: "Притягивает влагу в роговой слой кожи." },
            "niacinamide": { name: "Niacinamide (Ниацинамид / Витамин B3)", type: "Актив", desc: "Укрепляет барьер, регулирует себум, стимулирует синтез церамидов." },
            "phenoxyethanol": { name: "Phenoxyethanol (Феноксиэтанол)", type: "Консервант", desc: "Защищает косметику от развития бактерий." },
            "ethylhexylglycerin": { name: "Ethylhexylglycerin (Этилгексилглицерин)", type: "Консервант / Эмолент", desc: "Мягкий компонент, усиливает действие консервантов." },
            "citric acid": { name: "Citric Acid (Лимонная кислота)", type: "Регулятор pH", desc: "Корректирует кислотность под естественный pH кожи." },
            
            // UV-фильтры
            "bis-ethylhexyloxyphenol methoxyphenyl triazine": { name: "Tinosorb S (Bis-Ethylhexyloxyphenol Methoxyphenyl Triazine)", type: "UV-фильтр", desc: "Сверхстабильный фильтр широкого спектра (UVA + UVB)." },
            "diethylamino hydroxybenzoyl hexyl benzoate": { name: "Uvinul A Plus (Diethylamino Hydroxybenzoyl Hexyl Benzoate)", type: "UV-фильтр", desc: "Фотостабильный фильтр для защиты от UVA-лучей." },
            "ethylhexyl triazone": { name: "Uvinul T 150 (Ethylhexyl Triazone)", type: "UV-фильтр", desc: "Высокоэффективный фильтр против UVB-лучей." },
            "methylene bis-benzotriazolyl tetramethylbutylphenol": { name: "Tinosorb M", type: "UV-фильтр", desc: "Гибридный фильтр широкого спектра защиты." },
            "ethylhexyl salicylate": { name: "Ethylhexyl Salicylate (Octisalate)", type: "UV-фильтр", desc: "Поглощает UVB-излучение." },
            "homosalate": { name: "Homosalate", type: "UV-фильтр", desc: "Классический солнцезащитный компонент." },
            "octocrylene": { name: "Octocrylene", type: "UV-фильтр", desc: "Защита от UVB и стабилизатор формулы." },
            "butyl methoxydibenzoylmethane": { name: "Avobenzone", type: "UV-фильтр", desc: "Фильтр против UVA-лучей." },

            // Активы тонера и кремов
            "inulin": { name: "Inulin (Инулин)", type: "Пребиотик", desc: "Поддерживает здоровый микробиом кожи." },
            "taurine": { name: "Taurine (Таурин)", type: "Пребиотик", desc: "Энергетический компонент для клеток кожи." },
            "pullulan": { name: "Pullulan (Пуллулан)", type: "Лифтинг-агент", desc: "Обеспечивает мгновенное увлажнение и текстуру." },
            "arabinogalactan": { name: "Arabinogalactan", type: "Пребиотик", desc: "Укрепляет местный иммунитет кожи." },
            "fructooligosaccharides": { name: "Fructooligosaccharides", type: "Пребиотик", desc: "Стимулирует рост полезной микрофлоры." },
            "lactococcus ferment lysate": { name: "Lactococcus Ferment Lysate", type: "Пробиотик", desc: "Восстанавливает микробиом и снижает чувствительность." },
            "centella asiatica extract": { name: "Centella Asiatica Extract", type: "Экстракт", desc: "Снимает воспаления и ускоряет регенерацию." },
            "lactosporin": { name: "LactoSporin", type: "Постбиотик", desc: "Защитное и противовоспалительное действие." },
            "resveratrol": { name: "Resveratrol (Ресвератрол)", type: "Антиоксидант", desc: "Защита от фотостарения и глиcкации." },
            "rosmarinyl glucoside": { name: "Rosmarinyl Glucoside", type: "Антиоксидант", desc: "Нейтрализует оксидативный стресс." },

            // База, ПАВы, липиды
            "cocamidopropyl betaine": { name: "Cocamidopropyl Betaine", type: "Амфотерный ПАВ", desc: "Мягкое очищение на основе кокоса." },
            "sodium cocoyl glutamate": { name: "Sodium Cocoyl Glutamate", type: "Анионный ПАВ", desc: "Сверхмягкий аминокислотный тензид." },
            "squalane": { name: "Squalane (Сквалан)", type: "Эмолент", desc: "Родственный коже липид, смягчает без утяжеления." },
            "isohexadecane": { name: "Isohexadecane", type: "Эмолент", desc: "Обеспечивает шелковистость текстуры." },
            "caprylic/capric triglyceride": { name: "Caprylic/Capric Triglyceride", type: "Эмолент", desc: "Стабильный компонент липидного слоя." },
            "ceramide np": { name: "Ceramide NP (Церамид 3)", type: "Церамид", desc: "Восстанавливает защитный барьер эпидермиса." },
            "ceramide ap": { name: "Ceramide AP", type: "Церамид", desc: "Укрепляет межклеточный цемент кожи." },
            "ceramide eop": { name: "Ceramide EOP", type: "Церамид", desc: "Обеспечивает барьерную непроницаемость." },
            "phytosphingosine": { name: "Phytosphingosine", type: "Липид", desc: "Противовоспалительный компонент." },
            "cholesterol": { name: "Cholesterol", type: "Липид", desc: "Работает в синергии с церамидами." },
            "linoleic acid": { name: "Linoleic Acid (Омега-6)", type: "ПНЖК", desc: "Ключевая кислота для барьера и при склонности к акне." }
        };

        function analyzeINCI() {
            const input = document.getElementById('inciInput').value;
            const container = document.getElementById('resultsContainer');
            const list = document.getElementById('ingredientsList');
            
            if (!input.trim()) {
                alert('Пожалуйста, введите или выберите состав для анализа.');
                return;
            }

            const rawItems = input.split(/,|\n/);
            list.innerHTML = '';

            rawItems.forEach(item => {
                const cleanName = item.trim();
                if (!cleanName) return;

                const lookupKey = cleanName.toLowerCase().replace(/\s*\(.*?\)\s*/g, '').trim();
                const info = ingredientDatabase[lookupKey];

                const itemCard = document.createElement('div');
                itemCard.className = "p-4 rounded-lg border border-luxury-border bg-luxury-bg/50 flex flex-col sm:flex-row sm:items-center justify-between gap-2 transition";

                if (info) {
                    itemCard.innerHTML = `
                        <div>
                            <span class="font-medium text-luxury-dark text-sm tracking-wide">${info.name}</span>
                            <p class="text-xs text-stone-500 mt-0.5">${info.desc}</p>
                        </div>
                        <span class="self-start sm:self-center px-2.5 py-1 text-[10px] uppercase tracking-wider font-semibold bg-luxury-gold/10 text-luxury-gold border border-luxury-gold/20 rounded">${info.type}</span>
                    `;
                } else {
                    itemCard.innerHTML = `
                        <div>
                            <span class="font-normal text-stone-700 text-sm">${cleanName}</span>
                            <p class="text-[11px] text-stone-400 mt-0.5">Компонент базы</p>
                        </div>
                        <span class="self-start sm:self-center px-2.5 py-1 text-[10px] uppercase tracking-wider font-medium bg-stone-200/60 text-stone-600 rounded">Ингредиент</span>
                    `;
                }

                list.appendChild(itemCard);
            });

            container.classList.remove('hidden');
        }

        function loadPreset(type) {
            const input = document.getElementById('inciInput');
            if (type === 'foam') {
                input.value = "Aqua, Cocamidopropyl Betaine, Glycerin, Sodium Cocoyl Glutamate, Betaine, Glycine, Panthenol, Phenoxyethanol, Citric Acid, Ethylhexylglycerin";
            } else if (type === 'toner') {
                input.value = "Aqua, Inulin, Taurine, Pullulan, Arabinogalactan, Fructooligosaccharides, Lactococcus Ferment Lysate, Centella Asiatica Extract, Niacinamide, LactoSporin, Glycerin, Phenoxyethanol, Ethylhexylglycerin, Citric Acid";
            } else if (type === 'cream') {
                input.value = "Aqua, Squalane, Isohexadecane, Caprylic/Capric Triglyceride, Ceramide NP, Ceramide AP, Ceramide EOP, Phytosphingosine, Cholesterol, Linoleic Acid, Glycerin, Phenoxyethanol, Ethylhexylglycerin, Citric Acid";
            } else if (type === 'spf') {
                input.value = "Aqua, Bis-Ethylhexyloxyphenol Methoxyphenyl Triazine, Diethylamino Hydroxybenzoyl Hexyl Benzoate, Ethylhexyl Triazone, Resveratrol, Rosmarinyl Glucoside, Niacinamide, Glycerin, Phenoxyethanol, Ethylhexylglycerin, Citric Acid";
            }
            analyzeINCI();
        }

        function clearAll() {
            document.getElementById('inciInput').value = '';
            document.getElementById('resultsContainer').classList.add('hidden');
        }
    </script>
</body>
</html>

